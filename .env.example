# =============================================================================
# Cloud Coding Platform — environment configuration template
# =============================================================================
# Copy to `.env` and fill in values.  NEVER commit the real `.env`.
# Generate secrets with:  make gen-secrets   (or: openssl rand -hex 24)
#
# This file contains NO real credentials. Placeholder values use the
# CHANGE_ME marker and must be replaced before starting the stack.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
# AI_PROVIDER_MODE selects which LiteLLM model configuration is mounted:
#   mock    - a built-in LiteLLM mock provider (no AWS account, no API keys)
#   bedrock - AWS Bedrock models via the EC2 instance profile (AWS only)
AI_PROVIDER_MODE=mock

# Deployment target used by scripts: `local` (Docker Compose on this machine)
# or `aws` (the EC2 POC instance). Local dev MUST stay on `local`.
DEPLOY_TARGET=local

# -----------------------------------------------------------------------------
# Component versions (pinned; verify digests before AWS deployment)
# Registry-verified 2026-11-10 (see PROJECT_STATUS.md):
#   postgres:16.4-alpine3.20                @ sha256:5660c2cbfea5...
#   litellm-database:main-v1.83.14-stable.patch.3 @ sha256:ec721a5e4b0d...
#   coder/coder:v2.36.3 (ghcr.io)           @ sha256:e71d75fac874...
# NOTE: current Coder images are published on GHCR only. Docker Hub
# `codercom/coder` is the discontinued v1.x product — do not use it.
POSTGRES_IMAGE=postgres:16.4-alpine3.20
LITELLM_IMAGE=ghcr.io/berriai/litellm-database:main-v1.83.14-stable.patch.3
CODER_IMAGE=ghcr.io/coder/coder:v2.36.3

# -----------------------------------------------------------------------------
# PostgreSQL (platform metadata: Coder + LiteLLM)
# -----------------------------------------------------------------------------
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=CHANGE_ME            # superuser password (openssl rand -hex 24)
POSTGRES_DB=postgres                   # initial DB; app DBs created by init script
CODER_PG_DATABASE=coder
CODER_PG_USER=coder_app
CODER_PG_PASSWORD=CHANGE_ME
LITELLM_PG_DATABASE=litellm
LITELLM_PG_USER=litellm_app
LITELLM_PG_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Coder (workspace control plane)
# -----------------------------------------------------------------------------
# URL that is reachable BOTH from the developer's browser AND from inside
# workspace containers.
#   local : http://host.docker.internal:7080 (add hosts entry, see docs/operations/development.md)
#   aws   : http://<EC2_PUBLIC_IP>:7080
CODER_ACCESS_URL=http://host.docker.internal:7080
CODER_HTTP_PORT=7080
# Bootstrap administrator (first login for the platform operator)
CODER_ADMIN_USER=platform-admin
CODER_ADMIN_EMAIL=admin@example.invalid
CODER_ADMIN_PASSWORD=CHANGE_ME         # >= 8 chars

# -----------------------------------------------------------------------------
# LiteLLM (AI gateway)
# -----------------------------------------------------------------------------
LITELLM_PORT=4000
# Master key: guards the LiteLLM admin API/UI. NEVER handed to developers or
# injected into workspaces. Prefix sk- is required.
LITELLM_MASTER_KEY=CHANGE_ME           # e.g. sk-$(openssl rand -hex 24)
# Database salt: required in DB mode to encrypt stored credentials
LITELLM_SALT_KEY=CHANGE_ME
# Default per-developer monthly budget (USD) applied to virtual keys
LITELLM_DEFAULT_USER_BUDGET=20
# Default per-developer rate limits
LITELLM_DEFAULT_RPM=30
LITELLM_DEFAULT_TPM=100000

# -----------------------------------------------------------------------------
# AI provider — AWS Bedrock mode (AWS deployment ONLY; ignored in mock mode)
# -----------------------------------------------------------------------------
# No static AWS keys. LiteLLM uses the EC2 instance profile and runs on the
# host network so it can reach IMDS; workspaces cannot (IMDS hop limit = 1).
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ANTHROPIC=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_AMAZON=amazon.nova-pro-v1:0

# -----------------------------------------------------------------------------
# Workspaces
# -----------------------------------------------------------------------------
# Endpoint workspaces use to reach LiteLLM (same host-gateway mechanism as
# CODER_ACCESS_URL).
LITELLM_BASE_URL=http://host.docker.internal:4000
# Idle autostop for workspaces (minutes). Workspaces stop automatically when
# nobody is connected. 0 disables autostop (not recommended).
WORKSPACE_DEFAULT_AUTOSTOP_MINUTES=45
# Maximum allowed concurrent workspaces on the single instance (guardrail)
WORKSPACE_MAX_CONCURRENT=5

# -----------------------------------------------------------------------------
# AWS POC deployment (used only by infra/terraform + deploy scripts)
# -----------------------------------------------------------------------------
AWS_REGION_TF=ap-southeast-1
TF_VAR_environment=cloud-coding-poc
# Instance sizing: see docs/operations/deployment.md cost model before changing
TF_VAR_instance_type=m6a.2xlarge
TF_VAR_root_volume_size_gb=200
